{
  "$comment": "Single source of truth shared by the Lovable web shell and the OnSpace.ai / Expo native app. Mirrors src/lib/permissions.ts. The native repo's app.json MUST keep expo.android.permissions and expo.android.blockedPermissions byte-identical to the arrays below. Verified against butler-ai-final/app.json (Butler AI 5.0.9) on 2026-08-01.",
  "native": {
    "$comment": "Identity fields copied from the OnSpace/Expo app.json so the two repos cannot drift.",
    "name": "Butler AI",
    "slug": "butler-ai",
    "scheme": "butlerai",
    "androidPackage": "com.butlerai.pc.automation",
    "iosBundleIdentifier": "com.butlerai.pc.automation",
    "userInterfaceStyle": "dark",
    "orientation": "portrait",
    "backgroundColor": "#0C0E14"
  },
  "android": {
    "permissions": [
      "android.permission.INTERNET",
      "android.permission.CAMERA",
      "android.permission.VIBRATE"
    ],
    "blockedPermissions": [
      "android.permission.RECORD_AUDIO",
      "android.permission.ACCESS_FINE_LOCATION",
      "android.permission.ACCESS_COARSE_LOCATION",
      "android.permission.ACCESS_BACKGROUND_LOCATION",
      "android.permission.READ_CONTACTS",
      "android.permission.READ_PHONE_STATE",
      "android.permission.PHONE_CALL",
      "android.permission.READ_EXTERNAL_STORAGE",
      "android.permission.WRITE_EXTERNAL_STORAGE",
      "android.permission.READ_MEDIA_IMAGES",
      "android.permission.READ_MEDIA_VIDEO",
      "android.permission.READ_MEDIA_AUDIO",
      "android.permission.MEDIA_PROJECTION",
      "android.permission.FOREGROUND_SERVICE",
      "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
      "android.permission.BODY_SENSORS",
      "android.permission.ACTIVITY_RECOGNITION",
      "com.google.android.gms.permission.ACTIVITY_RECOGNITION"
    ]
  },
  "ios": {
    "NSCameraUsageDescription": "Butler AI uses the camera once to scan the pairing QR code shown by your PC. Nothing is recorded or uploaded."
  },
  "web": {
    "runtimeRequested": ["camera", "notifications", "clipboard-write", "screen-wake-lock"],
    "neverRequested": ["microphone", "geolocation", "midi", "bluetooth", "usb", "idle-detection"]
  }
}
